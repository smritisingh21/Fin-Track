# ==========================================
# FinTrack Docker Environment Configuration
# ==========================================
# Copy this file to .env at the root of the project to customize settings:
#   cp .env.docker.example .env

# Port settings
PORT=8000

# Database Connection:
# 1. Option A: Use local containerized MongoDB (default in docker-compose.yml)
MONGO_URI=mongodb://mongodb:27017/expense-tracker

# 2. Option B: Use MongoDB Atlas Cloud (uncomment and replace with your connection string)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/expense-tracker?retryWrites=true&w=majority

# JWT Authentication Secret (replace with a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_here

# Google OAuth Client ID (optional, for Google Sign-in if configured)
CLIENT_ID=

# Google Gemini API Key (optional, for AI Financial Insights)
GEMINI_API_KEY=

# Frontend API URL:
# Leave blank to use Nginx's automatic internal reverse proxy to backend,
# or set to http://localhost:8000 if frontend calls backend directly.
VITE_API_BASE_URL=

